# Required: your YNAB Personal Access Token
# Generate at https://app.ynab.com/settings/developer
YNAB_API_KEY=your_personal_access_token_here

# Recommended: your default budget/plan ID
# Find it in the URL when viewing your budget: app.ynab.com/ynab/budgets/<PLAN_ID>/
YNAB_PLAN_ID=your_budget_id_here

# Optional: logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
