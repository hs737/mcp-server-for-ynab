# Required: your YNAB Personal Access Token
# Generate at https://app.ynab.com/settings/developer
YNAB_API_KEY=your_personal_access_token_here

# Recommended: your default budget/plan ID
# Find it in the URL when viewing your budget: app.ynab.com/ynab/budgets/<PLAN_ID>/
YNAB_PLAN_ID=your_budget_id_here

# Optional: enable write tools. Unset or falsy means read-only, and the write
# tools are not registered at all — an agent cannot see or call them.
# Accepts 1, true, yes, or on. Leave this off until you want an agent changing
# real budget data.
# YNAB_ALLOW_WRITES=1

# Optional: where the write history lives. Every write records the state before
# it, which is what history_revert restores.
# Default: ~/.mcp-for-ynab/history.jsonl
# YNAB_HISTORY_PATH=~/.mcp-for-ynab/history.jsonl

# Optional: client-side request budget. YNAB allows 200 requests per hour per
# token; this server stays below that so the limit you hit is the local one,
# with a clear error, rather than a 429 mid-workflow.
# YNAB_RATE_LIMIT_PER_HOUR=190
# YNAB_RATE_WARN_THRESHOLD=50

# Optional: logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
